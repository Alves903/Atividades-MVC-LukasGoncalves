@model List<FuncionariosMVC.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
}

<h1>Funcionários</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Cargo</th>
            <th>Departamento</th>
            <th>Salário</th>
            <th>Situação</th>
            <th>Faixa Salarial</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var funcionario in Model)
        {
            <tr>
                <td>@funcionario.Nome</td>
                <td>@funcionario.Cargo</td>
                <td>@funcionario.Departamento</td>
                <td>R$ @funcionario.Salario</td>

                <td>
                    @if (funcionario.Ativo)
                    {
                        <span>Funcionário ativo</span>
                    }
                    else
                    {
                        <span>Funcionário desligado</span>
                    }
                </td>

                <td>
                    @if (funcionario.Salario < 2500)
                    {
                        <span>Faixa 1</span>
                    }
                    else if (funcionario.Salario <= 5000)
                    {
                        <span>Faixa 2</span>
                    }
                    else
                    {
                        <span>Faixa 3</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>