@model List<CursosMVC.Models.Curso>

@{
    ViewData["Title"] = "Cursos Presenciais";
}

<h1>Cursos Presenciais</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Carga Horária</th>
            <th>Vagas</th>
            <th>Valor</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var curso in Model)
        {
            <tr>
                <td>@curso.Nome</td>
                <td>@curso.CargaHoraria horas</td>
                <td>@curso.Vagas</td>
                <td>R$ @curso.Valor</td>
            </tr>
        }
    </tbody>
</table>