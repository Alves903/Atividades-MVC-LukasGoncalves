@model List<VeterinariaMVC.Models.Animal>

@{
    ViewData["Title"] = "Gatos";
}

<h1>Gatos</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Idade</th>
            <th>Dono</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var animal in Model)
        {
            <tr>
                <td>@animal.Nome</td>
                <td>@animal.Idade</td>
                <td>@animal.Dono</td>
            </tr>
        }
    </tbody>
</table>