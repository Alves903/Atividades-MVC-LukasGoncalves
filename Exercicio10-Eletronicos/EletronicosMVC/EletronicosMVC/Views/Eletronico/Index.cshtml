@model List<EletronicosMVC.Models.Eletronico>

@{
    ViewData["Title"] = "Eletrônicos";
}

<h1>Loja de Eletrônicos</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Marca</th>
            <th>Categoria</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th>Situação</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var eletronico in Model)
        {
            <tr>
                <td>@eletronico.Nome</td>
                <td>@eletronico.Marca</td>
                <td>@eletronico.Categoria</td>
                <td>R$ @eletronico.Preco</td>
                <td>@eletronico.Estoque</td>
                <td>
                    @if (eletronico.Estoque > 0)
                    {
                        <span>Disponível</span>
                    }
                    else
                    {
                        <span>Produto esgotado</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>