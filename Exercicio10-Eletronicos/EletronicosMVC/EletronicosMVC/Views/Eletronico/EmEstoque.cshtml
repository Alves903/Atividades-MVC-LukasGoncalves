@model List<EletronicosMVC.Models.Eletronico>

@{
    ViewData["Title"] = "Produtos em Estoque";
}

<h1>Produtos em Estoque</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Marca</th>
            <th>Categoria</th>
            <th>Preço</th>
            <th>Estoque</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var eletronico in Model)
        {
            <tr>
                <td>@eletronico.Nome</td>
                <td>@eletronico.Marca</td>
                <td>@eletronico.Categoria</td>
                <td>R$ @eletronico.Preco</td>
                <td>@eletronico.Estoque</td>
            </tr>
        }
    </tbody>
</table>