@model List<BibliotecaMVC.Models.Livro>

@{
    ViewData["Title"] = "Biblioteca";
}

<h1>Livros da Biblioteca</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Título</th>
            <th>Autor</th>
            <th>Ano</th>
            <th>Situação</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var livro in Model)
        {
            <tr>
                <td>@livro.Titulo</td>
                <td>@livro.Autor</td>
                <td>@livro.Ano</td>
                <td>
                    @if (livro.Disponivel)
                    {
                        <span>Disponível para empréstimo</span>
                    }
                    else
                    {
                        <span>Emprestado</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>