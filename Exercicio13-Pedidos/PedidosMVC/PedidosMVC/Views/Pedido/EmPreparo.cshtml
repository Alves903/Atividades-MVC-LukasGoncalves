@model List<PedidosMVC.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos em Preparo";
}

<h1>Pedidos em Preparo</h1>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Cliente</th>
            <th>Produto</th>
            <th>Quantidade</th>
            <th>Valor Total</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var pedido in Model)
        {
            decimal total = pedido.Quantidade * pedido.PrecoUnitario;

            <tr>
                <td>@pedido.Cliente</td>
                <td>@pedido.Produto</td>
                <td>@pedido.Quantidade</td>
                <td>R$ @total</td>
            </tr>
        }
    </tbody>
</table>